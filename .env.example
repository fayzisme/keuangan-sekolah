# =====================================================================
# .env.example — salin ke .env untuk Docker Compose.
# JANGAN PERNAH commit .env asli ke git.
# Di server produksi, file .env dibuat langsung di server (isi manual).
# =====================================================================

# ---------- Aplikasi ----------
APP_NAME="School Finance"
APP_ENV=production
# Generate dengan: php artisan key:generate (di server)
APP_KEY=
APP_DEBUG=false
APP_URL=https://<DOMAIN>
FRONTEND_URL=https://<DOMAIN>
SANCTUM_STATEFUL_DOMAINS=<DOMAIN>

# Kunci level-platform utk onboarding sekolah (POST /api/v1/platform/schools).
# WAJIB diisi di produksi; kosong => endpoint onboarding dimatikan (503).
# Generate: openssl rand -hex 32. Kirim via header: X-Platform-Key: <nilai>
PLATFORM_KEY=

# ---------- Database ----------
DB_DATABASE=school_finance
DB_USERNAME=school_finance
# WAJIB: password kuat (min 16 karakter acak) — generate: openssl rand -base64 24
DB_PASSWORD=

# ---------- Redis ----------
# Diisi untuk produksi: openssl rand -hex 16
REDIS_PASSWORD=

# ---------- Docker image ----------
# Tag image yang di-deploy (dipakai untuk rollback)
APP_IMAGE_TAG=latest

# ---------- Backup ----------
BACKUP_DIR=/var/backups/school-finance
BACKUP_KEEP_DAYS=30
# AKTIFKAN bila enkripsi backup dipakai: backup.sh akan pakai GPG
# GPG_KEY_ID=

# ---------- Integrasi (fast-follow Midtrans — DIISI LALU) ----------
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_SANDBOX=true

# ---------- Notifikasi (fast-follow) ----------
# MAIL_MAILER=log
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=